{
  "name": "@hyperse/track",
  "version": "1.1.0",
  "description": "A typed, smart, scalable, powerful data collection engine written in typescript",
  "keywords": [
    "hyperse",
    "middleware",
    "pipeline",
    "pipe",
    "track engine",
    "google track",
    "facebook track",
    "klaviyo track"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/track.git",
    "directory": "packages/track"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "typecheck": "run-s build typecheck-lib",
    "typecheck-lib": "tsc --project ./tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hyperse/pipeline": "^1.0.6"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.3",
    "@hyperse/vitest-coverage-reporter": "^1.0.16",
    "@types/lodash": "^4",
    "@types/node": "^25.8.0",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^10.3.0",
    "npm-run-all": "^4.1.5",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
