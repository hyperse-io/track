{
  "name": "@hyperse/track-monorepo",
  "private": true,
  "description": "Monorepo for @hyperse/track and related packages",
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/track.git"
  },
  "workspaces": [
    "packages/*",
    "website",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn workspace @hyperse/track build",
    "lint": "yarn workspace @hyperse/track lint",
    "lint-fix": "yarn workspace @hyperse/track lint-fix",
    "test": "yarn workspace @hyperse/track test",
    "test-ui": "yarn workspace @hyperse/track test-ui",
    "coverage": "yarn workspace @hyperse/track coverage",
    "typecheck": "run-s build typecheck-track typecheck-next-example",
    "typecheck-track": "yarn workspace @hyperse/track typecheck",
    "typecheck-next-example": "yarn workspace @hyperse/next-example typecheck",
    "lint-staged-files": "lint-staged --allow-empty",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "test:coverage": "yarn workspace @hyperse/track test:coverage",
    "cz": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@hyperse/eslint-config-hyperse": "^1.7.3",
    "@hyperse/exec-program": "^1.2.1",
    "@hyperse/vitest-coverage-reporter": "^1.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "next": "16.2.6",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.14.1",
  "license": "MIT"
}
