254":{"id":"/docs/plugins/facebook-adapter-2","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"The FacebookAdapter streamlines the integration of Facebook Pixel event tracking within your @hyperse/track system, enabling you to leverage the full power of the Meta Pixel for comprehensive data collection and analysis."},"255":{"id":"/docs/plugins/facebook-adapter-3","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**Key Features:**"},"256":{"id":"/docs/plugins/facebook-adapter-4","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**Streamlined Pixel Integration:** Seamlessly integrate your Facebook Pixel with your @hyperse/track setup for a unified and efficient tracking experience."},"257":{"id":"/docs/plugins/facebook-adapter-5","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**TypeScript Typing:** Benefit from robust type safety and code completion through TypeScript definitions, ensuring accurate event data and reducing errors."},"258":{"id":"/docs/plugins/facebook-adapter-6","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**Comprehensive Event Tracking:** Track a wide range of events, including those essential for optimizing conversions, such as:"},"259":{"id":"/docs/plugins/facebook-adapter-7","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**View Content:** Track when users view specific products or content."},"260":{"id":"/docs/plugins/facebook-adapter-8","page_id":"/docs/plugins/facebook-adapter","tags":[],"type":"text","url":"/docs/plugins/facebook-adapter","content":"**Add to Cart:** Capture when users add items to their shopping carts."},"261":{"id":"/docs